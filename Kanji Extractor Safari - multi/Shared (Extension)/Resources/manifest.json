{
  "manifest_version": 3,
  "name": "__MSG_extension_name__",
  "version": "1.0",
  "description": "__MSG_extension_description__",
  "default_locale": "en",

  "icons": {
    "16":  "icons/icon-16.png",
    "32":  "icons/icon-32.png",
    "48":  "icons/icon-48.png",
    "64":  "icons/icon-64.png",
    "96":  "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extension_name__",
    "default_icon": {
      "16": "icons/toolbar-icon-16.png",
      "19": "icons/toolbar-icon-19.png",
      "32": "icons/toolbar-icon-32.png",
      "38": "icons/toolbar-icon-38.png",
      "64": "icons/toolbar-icon-64.png",
      "128": "icons/toolbar-icon-128.png",
      "256": "icons/toolbar-icon-256.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "activeTab",
    "scripting"
  ]
}
